# Pickle — environment variables. Copy to .env.local and fill in what you have.
# Everything is optional: with nothing set the product runs in local demo mode.

# Public site URL used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:5500

# Supabase (optional). When both public values are set the waitlist, partner
# applications and saved perks persist to Supabase; otherwise they stay local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used by API routes for inserts.
SUPABASE_SERVICE_ROLE_KEY=

# Launch facts shown in the FAQ. Leave blank to show "to be confirmed".
NEXT_PUBLIC_LAUNCH_REGIONS=
NEXT_PUBLIC_LAUNCH_TIMING=
NEXT_PUBLIC_ISSUER_NAME=

# Payment provider boundary (server-only). The mock provider needs no keys.
# PAYMENT_PROVIDER=mock | <future live adapter>
PAYMENT_PROVIDER=mock
# Shared secret used to verify webhook signatures (HMAC-SHA256 over the raw body).
PAYMENT_WEBHOOK_SECRET=

# Analytics provider (optional). With nothing set, events go to a local logger.
# NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# Spam protection for forms: minimum seconds between form render and submit.
FORM_MIN_SECONDS=3

# Google Maps (optional). With a key, Pickle Radar renders a real Google map with
# place search; without one it falls back to the illustrated demo map.
# Enable "Maps JavaScript API", "Places API (New)" and "Geocoding API" for the key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional cloud Map ID for custom styling; the DEMO_MAP_ID default works for testing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Default Radar centre ("lat,lng") and its label, used until the visitor picks a place.
NEXT_PUBLIC_RADAR_CENTER=-8.6913,115.1683
NEXT_PUBLIC_RADAR_CENTER_LABEL=Seminyak, Bali
